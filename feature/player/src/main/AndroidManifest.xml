<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.oplus.cast" />
        <intent>
            <action android:name="oplus.intent.action.cast.device.display" />
        </intent>
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_DISPLAY_SETTINGS" />
        </intent>
    </queries>

    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="top.jlen.vod.ui.JlenCastOptionsProvider" />
    </application>

</manifest>
